# ============================================================
# Horizonte Quindío Prospectiva 2050 — Variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# docker compose lee este archivo automáticamente (.env en la raíz).
# ============================================================

# --- Base de datos local (docker compose) ---
POSTGRES_USER=hq2050
POSTGRES_PASSWORD=hq2050_secret
POSTGRES_DB=hq2050

# --- API (NestJS) ---
# En el primer despliegue apunta a Supabase (mismo formato postgres://).
# Cuando migres a tu instancia, apunta al container de Postgres propio y listo.
DATABASE_URL=postgresql://hq2050:hq2050_secret@db:5432/hq2050
JWT_SECRET=cambia_esta_clave_secreta_por_una_robusta_de_al_menos_32_caracteres
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Web (Next.js) — usada durante el build (SSG) ---
PUBLIC_API_URL=http://localhost:3000

# --- Admin (React + Vite) — usada durante el build ---
VITE_API_URL=http://localhost:3000